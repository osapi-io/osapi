package widget

// ListInput is list's input, which has none.
type ListInput struct{}

// GetInput names the item to read. The field tagged in:"path" is the key
// of the path, and each field becomes a flag of the CLI command.
type GetInput struct {
	Name string `json:"name" in:"path" validate:"required,min=1,max=255" doc:"The name of the item." example:"example"`
}

// WidgetItem is one item. Its name is the name of its schema, so it has the
// group's name in front. Each field becomes a schema property.
type WidgetItem struct {
	Name string `json:"name" doc:"The name of the item." example:"example"`
}

// WidgetList is the items, with the total.
type WidgetList struct {
	Items []WidgetItem `json:"items"`
	Total int          `json:"total" doc:"The number of items."`
}
