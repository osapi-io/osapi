// Package widget is the widget endpoint group: Widgets of the controller.
package widget

import (
	"errors"
	"strings"

	"github.com/osapi-io/osapi/internal/area"
	"github.com/osapi-io/osapi/internal/controller/endpoint"
)

// ErrNotFound is an item that is not there.
var ErrNotFound = errors.New("not found")

// Group is the widget group's definition. The routes, the spec, the CLI
// commands and their pages come from it. osapi dsl endpoint spec get
// lists every option.
var Group = endpoint.Register(endpoint.Define(
	"widget", "Widgets of the controller",
	endpoint.Area(area.Fleet),
	endpoint.Uses[Deps](),
	endpoint.Get[ListInput, ItemList]("list").
		Handle(List).
		Describe("List the widget items").
		Example(""),
	endpoint.Get[GetInput, Item]("get").
		Handle(Get).
		Key("name").
		Describe("Get one widget item").
		Errors(endpoint.NotFound(ErrNotFound, "No item with that name.")).
		Fails("a name over 255 characters", GetInput{Name: strings.Repeat("a", 256)}).
		Example("--name example"),
))
