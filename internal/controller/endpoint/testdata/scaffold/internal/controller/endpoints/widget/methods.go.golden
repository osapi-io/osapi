package widget

import (
	"context"

	"github.com/osapi-io/osapi/internal/controller/endpoint"
)

// items stand in for what the group reads, such as a KV bucket: a
// handler gets it from Deps.
var items = []Item{{Name: "example"}}

// List is every item.
func List(
	_ context.Context,
	_ Deps,
	_ ListInput,
) (ItemList, error) {
	return ItemList{Items: items, Total: len(items)}, nil
}

// Get is the item with the name. An item that is not there is ErrNotFound,
// which Errors maps to 404; endpoint.Errorf keeps the name in the message.
func Get(
	_ context.Context,
	_ Deps,
	in GetInput,
) (Item, error) {
	for _, it := range items {
		if it.Name == in.Name {
			return it, nil
		}
	}

	return Item{}, endpoint.Errorf(ErrNotFound, "no item named %q", in.Name)
}
