package ntpconf

import (
	"context"
	"errors"
	"fmt"
	"io/fs"
	"path/filepath"

	"github.com/avfs/avfs"

	"github.com/osapi-io/osapi/internal/atomicfile"
	"github.com/osapi-io/osapi/internal/behavior"
	"github.com/osapi-io/osapi/internal/behavior/host"
	"github.com/osapi-io/osapi/internal/behaviors/managedfile"
)

// debian keeps the value in a file. debian_public_test.go tests it on an
// in-memory filesystem, and the examples in behavior.go run it on a fake
// host.
type debian struct {
	fs   avfs.VFS
	path string
	// managedfile is the provider of the managedfile behavior, which this one
	// requires. Call its methods with behavior.Call, so the trace shows each call
	// as a step:
	//
	//	behavior.Call(ctx, managedfile.Behavior, managedfile.Get, d.managedfile, in)
	managedfile managedfile.Provider
}

// newDebian is the provider on Debian and its family, built by the agent at
// startup with the host and the behavior's settings. It declines a host where a
// behavior it requires has no provider, and the methods report skipped there.
func newDebian(
	h host.Host,
) (Provider, error) {
	managedfileProvider := host.Require[managedfile.Provider](h, managedfile.Behavior)
	if managedfileProvider == nil {
		return nil, behavior.ErrUnsupported
	}

	return &debian{
		fs:          h.FS,
		path:        host.Settings[Settings](h).Path,
		managedfile: managedfileProvider,
	}, nil
}

// Get reads the value; a value never set reads as empty.
func (d *debian) Get(
	_ context.Context,
) (string, error) {
	data, err := d.fs.ReadFile(d.path)
	if errors.Is(err, fs.ErrNotExist) {
		return "", nil
	}

	return string(data), err
}

// Set writes the value, and reports whether it changed.
func (d *debian) Set(
	ctx context.Context,
	value string,
) (bool, error) {
	if current, err := d.fs.ReadFile(d.path); err == nil && string(current) == value {
		return false, nil
	}
	if err := d.fs.MkdirAll(filepath.Dir(d.path), 0o755); err != nil {
		return false, fmt.Errorf("make the directory of %s: %w", d.path, err)
	}
	if err := atomicfile.Write(ctx, d.fs, d.path, []byte(value), 0o644); err != nil {
		return false, fmt.Errorf("write %s: %w", d.path, err)
	}

	return true, nil
}
