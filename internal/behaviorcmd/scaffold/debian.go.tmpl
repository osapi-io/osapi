package {{.Name}}

import (
	"context"
	"errors"
	"io/fs"
	"path/filepath"

	"github.com/avfs/avfs"

	"github.com/osapi-io/osapi/internal/behavior/host"
)

// debian keeps the value in a file. debian_public_test.go tests it on an
// in-memory filesystem, and the examples in behavior.go run it on a fake
// host.
type debian struct {
	fs   avfs.VFS
	path string
}

// newDebian is the provider on Debian and its family, built by the agent at
// startup with the host and the behavior's settings.
func newDebian(
	h host.Host,
) (Provider, error) {
	return &debian{fs: h.FS, path: host.Settings[Settings](h).Path}, nil
}

// Get reads the value; a value never set reads as empty.
func (d *debian) Get(
	_ context.Context,
) (string, error) {
	data, err := d.fs.ReadFile(d.path)
	if errors.Is(err, fs.ErrNotExist) {
		return "", nil
	}

	return string(data), err
}

// Set writes the value, and reports whether it changed.
func (d *debian) Set(
	_ context.Context,
	value string,
) (bool, error) {
	if current, err := d.fs.ReadFile(d.path); err == nil && string(current) == value {
		return false, nil
	}
	// A directory that cannot be made fails the write below, which reports it.
	_ = d.fs.MkdirAll(filepath.Dir(d.path), 0o755)

	return true, d.fs.WriteFile(d.path, []byte(value), 0o644)
}
