package {{.Name}}

// defaultPath is where the value is kept unless the config says otherwise.
const defaultPath = "/etc/osapi/{{.Name}}"

// Settings is the agent's standing config for {{.Name}}, under
// behaviors.{{.Name}}. Each field gets an OSAPI_BEHAVIORS_{{.Upper}}_<FIELD>
// variable and an osapi agent start flag. A value that changes per call
// belongs in an input type, not here.
type Settings struct {
	Path string `mapstructure:"path" doc:"File the {{.Name}} value is kept in." validate:"required,startswith=/"`
}

var defaults = Settings{Path: defaultPath}
