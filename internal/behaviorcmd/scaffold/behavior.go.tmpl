// Package {{.Name}} is the {{.Name}} behavior: {{.Doc}}.
package {{.Name}}

import "github.com/osapi-io/osapi/internal/behavior"

// Behavior is the {{.Name}} definition. The routes, the agent's dispatch, the
// CLI commands, the spec, the docs pages and the tests of every layer above
// the provider are built from it. go doc ./internal/behavior lists every option.
var Behavior = behavior.Register(behavior.Define(
	"{{.Name}}", {{printf "%q" .Doc}},
	behavior.Node,{{if .Group}}
	behavior.Under({{printf "%q" .Group}}),{{end}}
	behavior.API,
	behavior.CLI,
	behavior.Config(defaults),
	behavior.Platform("debian", newDebian),
	behavior.Read("get", Get).
		Describe("Get the {{.Name}} value").
		Example("Before anything is set", GetInput{}, Entry{}).
		Example("The current value", GetInput{}, Entry{Value: "example"},
			behavior.After(UpdateInput{Value: "example"}),
		),
	behavior.Write("update", Update).
		Describe("Set the {{.Name}} value").
		Explain("Writes the value to behaviors.{{.Name}}.path. Setting the value it "+
			"already has reports changed: false.").
		Example("A new value", UpdateInput{Value: "example"}, Result{Changed: true},
			behavior.Wrote(defaultPath, "example"),
		),
))
