package {{.Name}}_test

import (
	"context"
	"testing"

	"github.com/avfs/avfs/vfs/memfs"
	"github.com/stretchr/testify/suite"

	"github.com/osapi-io/osapi/internal/behavior/host"
	"github.com/osapi-io/osapi/internal/behaviors/{{.Path}}"
)

type DebianPublicTestSuite struct {
	suite.Suite

	provider {{.Name}}.Provider
}

func (s *DebianPublicTestSuite) SetupSubTest() {
	p, err := {{.Name}}.Behavior.Provider("debian", host.Host{
		FS:       memfs.New(),
		Settings: {{.Name}}.Settings{Path: "/etc/osapi/{{.Name}}"},
	})
	s.Require().NoError(err)
	s.provider = p.({{.Name}}.Provider)
}

func (s *DebianPublicTestSuite) TestGet() {
	tests := []struct {
		name  string
		setup func()
		want  string
	}{
		{
			name:  "when the value was never set, it reads as empty",
			setup: func() {},
		},
		{
			name: "when the value was set, it reads back",
			setup: func() {
				_, err := s.provider.Set(context.Background(), "hello")
				s.Require().NoError(err)
			},
			want: "hello",
		},
	}

	for _, tc := range tests {
		s.Run(tc.name, func() {
			tc.setup()

			got, err := s.provider.Get(context.Background())

			s.Require().NoError(err)
			s.Equal(tc.want, got)
		})
	}
}

func (s *DebianPublicTestSuite) TestSet() {
	tests := []struct {
		name        string
		setup       func()
		wantChanged bool
	}{
		{
			name:        "when the value is new, it is written",
			setup:       func() {},
			wantChanged: true,
		},
		{
			name: "when the file already holds the value, nothing changes",
			setup: func() {
				_, err := s.provider.Set(context.Background(), "hello")
				s.Require().NoError(err)
			},
		},
	}

	for _, tc := range tests {
		s.Run(tc.name, func() {
			tc.setup()

			changed, err := s.provider.Set(context.Background(), "hello")

			s.Require().NoError(err)
			s.Equal(tc.wantChanged, changed)
		})
	}
}

func TestDebianPublicTestSuite(
	t *testing.T,
) {
	suite.Run(t, new(DebianPublicTestSuite))
}
