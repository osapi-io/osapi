// Package widget is the widget group of local commands: Widgets of this host.
package widget

import (
	"strings"

	"github.com/osapi-io/osapi/internal/cli/command"
)

// Group is the widget group's definition. The commands, their flags,
// their help and their pages come from it. osapi cli command spec get lists
// every option.
var Group = command.Register(command.Define(
	"widget", "Widgets of this host",
	command.Uses[Deps](),
	command.Method[ListInput, WidgetList]("list").
		Short("List the widget items").
		Example("").
		Handle(List),
	command.Method[GetInput, WidgetItem]("get").
		Short("Get one widget item").
		Example("--name example").
		Fails("no name", GetInput{}).
		Fails("a name over 255 characters", GetInput{Name: strings.Repeat("a", 256)}).
		Handle(Get),
))
