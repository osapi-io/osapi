package widget

import (
	"context"
	"errors"
	"fmt"
)

// ErrNotFound is an item that is not there.
var ErrNotFound = errors.New("not found")

// items stand in for what the group reads, such as a file: a method gets
// it from Deps.
var items = []WidgetItem{{Name: "example"}}

// List is every item.
func List(
	_ context.Context,
	_ Deps,
	_ ListInput,
) (WidgetList, error) {
	return WidgetList{Items: items, Total: len(items)}, nil
}

// Get is the item with the name. An item that is not there is ErrNotFound,
// with the name in the message.
func Get(
	_ context.Context,
	_ Deps,
	in GetInput,
) (WidgetItem, error) {
	for _, it := range items {
		if it.Name == in.Name {
			return it, nil
		}
	}

	return WidgetItem{}, fmt.Errorf("no item named %q: %w", in.Name, ErrNotFound)
}
