package widget_test

import (
	"context"
	"testing"

	"github.com/stretchr/testify/suite"

	"github.com/osapi-io/osapi/internal/cli/commands/widget"
)

type MethodsPublicTestSuite struct {
	suite.Suite
}

func (s *MethodsPublicTestSuite) TestList() {
	got, err := widget.List(context.Background(), widget.Deps{}, widget.ListInput{})

	s.Require().NoError(err)
	s.Equal(1, got.Total)
}

func (s *MethodsPublicTestSuite) TestGet() {
	tests := []struct {
		name    string
		item    string
		wantErr error
	}{
		{
			name: "when the item is there, it is the answer",
			item: "example",
		},
		{
			name:    "when the item is not there, it is ErrNotFound",
			item:    "nosuch",
			wantErr: widget.ErrNotFound,
		},
	}

	for _, tc := range tests {
		s.Run(tc.name, func() {
			got, err := widget.Get(context.Background(), widget.Deps{}, widget.GetInput{Name: tc.item})

			if tc.wantErr != nil {
				s.ErrorIs(err, tc.wantErr)

				return
			}
			s.Require().NoError(err)
			s.Equal(tc.item, got.Name)
		})
	}
}

func TestMethodsPublicTestSuite(
	t *testing.T,
) {
	suite.Run(t, new(MethodsPublicTestSuite))
}
