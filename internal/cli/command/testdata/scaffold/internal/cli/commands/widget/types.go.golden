package widget

// ListInput is list's input, which has none.
type ListInput struct{}

// GetInput names the item to read. Each field is a flag of the command,
// named for its json name, with its doc as its help.
type GetInput struct {
	Name string `json:"name" validate:"required,min=1,max=255" doc:"The name of the item"`
}

// WidgetItem is one item. With --json, it prints as JSON.
type WidgetItem struct {
	Name string `json:"name"`
}

// WidgetList is the items, with the total.
type WidgetList struct {
	Items []WidgetItem `json:"items"`
	Total int          `json:"total"`
}
